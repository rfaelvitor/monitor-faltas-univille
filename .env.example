# copie para .env e preencha (o .env nunca vai pro git)
UNIVILLE_USUARIO=sua_matricula
UNIVILLE_SENHA=sua_senha_do_portal

# senha que você vai digitar para abrir o painel (invente uma)
SENHA_PAINEL=uma_senha_forte_qualquer

# alertas por e-mail (senha de app do Google, não a senha normal)
GMAIL_USUARIO=voce@gmail.com
GMAIL_SENHA_APP=xxxxxxxxxxxxxxxx
EMAIL_DESTINO=voce@gmail.com

# publicação do painel no GitHub Pages (token fine-grained com Contents: read and write)
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=seu_usuario/seu_repo
URL_PAINEL=https://seu_usuario.github.io/seu_repo/

# opcionais
# LIMITE_FALTAS=18
# NIVEIS_ALERTA=10,12,14,16,18
# LIMITES_ESPECIFICOS=FDIA=20,EIXO-III=20
# SEMESTRE=2026-2
# HEADLESS=0          # 0 abre o navegador na tela (útil pra depurar)
# LOG_DETALHADO=1     # mostra as faltas no log

# Pasta do perfil do navegador. Com HEADLESS=0 o padrão é ~/.monitor-faltas/perfil; "0" desliga
# PERFIL_NAVEGADOR=~/.monitor-faltas/perfil
